# Copy to .env and fill in. .env is gitignored.
#
# From https://developer.spotify.com/dashboard -> your app -> Settings.
# The Client ID is not a secret; PKCE needs no client secret, so do not add one.
SPOTIFY_CLIENT_ID=

# Optional: raises the GitHub rate limit for the devctx server (60 -> 5000/hr).
# GITHUB_TOKEN=
